# Copy values into Railway → Variables (do NOT commit real secrets)

# ---- Supabase Postgres (required) ----
# Use Transaction pooler (port 6543) or Session pooler — Railway is an external host.
# Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ---- LLM (required) ----
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Optional Gemini
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

SEARCH_RESULT_LIMIT=100
RECOMMEND_TOP_N=5
LOG_LEVEL=INFO
SHOW_ERRORS=1   # set to 0 in production

# ---- Security (see README → Security) ----
SESSION_SECRET=generate-a-long-random-string
DIAG_TOKEN=choose-a-secret-token
# Email codes (Resend)
RESEND_API_KEY=
MAIL_FROM=LuxeHome <login@yourdomain.com>
# SMS codes (Twilio) - optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# NEVER in production: prints/returns the sign-in code
# AUTH_DEV_MODE=1
# Rate limits (defaults shown)
# CHAT_PER_MIN=8
# CHAT_PER_DAY=150
# CHAT_GLOBAL_PER_DAY=5000
